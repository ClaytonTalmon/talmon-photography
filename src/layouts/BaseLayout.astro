---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Analytics from '../components/Analytics.astro';
import '../styles/global.css';
import { locales, type Locale } from '../i18n/utils';
import { localeHtmlLang } from '../i18n/translations';

interface Props {
  locale: Locale;
  title: string;
  description?: string;
  headerVariant?: 'light' | 'dark';
}

const { locale, title, description, headerVariant = 'light' } = Astro.props;
const currentPath = new URL(Astro.request.url).pathname;
const siteName = 'Talmon de l’Armée Photography';
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonicalPath =
  basePath && currentPath.startsWith(basePath)
    ? currentPath.slice(basePath.length) || '/'
    : currentPath;
const localePrefixPattern = new RegExp(`^/(${locales.join('|')})`);
const faviconPath = `${basePath}/favicon.svg`;
const alternatePath = (targetLocale: Locale) =>
  canonicalPath.replace(localePrefixPattern, `/${targetLocale}`);
---

<!doctype html>
<html lang={localeHtmlLang[locale]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={faviconPath} />
    <title>{title} — {siteName}</title>
    {description && <meta name="description" content={description} />}
    <meta name="generator" content={Astro.generator} />

    {locales.map((l) => (
      <link rel="alternate" hreflang={localeHtmlLang[l]} href={`https://www.claytontalmon.com${alternatePath(l)}`} />
    ))}
    <link rel="alternate" hreflang="x-default" href={`https://www.claytontalmon.com${alternatePath('en')}`} />

    <meta property="og:title" content={`${title} — ${siteName}`} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content="website" />

    <Analytics />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header locale={locale} currentPath={currentPath} variant={headerVariant} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
