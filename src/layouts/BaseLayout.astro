---
import { collectorText } from '../i18n/collector.mjs';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Analytics from '../components/Analytics.astro';
import '../styles/global.css';
import { locales, type Locale } from '../i18n/utils';
import { localeHtmlLang } from '../i18n/translations';

interface Props {
  locale: Locale;
  title: string;
  description?: string;
  headerVariant?: 'light' | 'dark';
}

const { locale, title, description, headerVariant = 'light' } = Astro.props;
const currentPath = new URL(Astro.request.url).pathname;
const siteName = 'Talmon de l’Armée Photography';
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonicalPath =
  basePath && currentPath.startsWith(basePath)
    ? currentPath.slice(basePath.length) || '/'
    : currentPath;
const localePrefixPattern = new RegExp(`^/(${locales.join('|')})`);
const isEditor = canonicalPath.includes('editions-editor');
const canonicalOrigin = /\/(editions|mailing-list)\//.test(canonicalPath) ? 'https://willowy-pika-c392c9.netlify.app' : 'https://talmonphoto.com';
const faviconPath = `${basePath}/favicon.svg`;
const alternatePath = (targetLocale: Locale) =>
  canonicalPath.replace(localePrefixPattern, `/${targetLocale}`);
const ct = (text: string) => collectorText(locale, text);
---

<!doctype html>
<html lang={localeHtmlLang[locale]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={faviconPath} />
    <title>{title} — {siteName}</title>
    {description && <meta name="description" content={description} />}
    <meta name="generator" content={Astro.generator} />

    {!isEditor && locales.map((l) => (
      <link rel="alternate" hreflang={localeHtmlLang[l]} href={`${canonicalOrigin}${alternatePath(l)}`} />
    ))}
    {!isEditor && <link rel="alternate" hreflang="x-default" href={`${canonicalOrigin}${alternatePath('en')}`} />}
    <link rel="canonical" href={`${canonicalOrigin}${canonicalPath}`} />
    {isEditor && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:url" content={`${canonicalOrigin}${canonicalPath}`} />

    <meta property="og:title" content={`${title} — ${siteName}`} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content="website" />

    <Analytics />
  </head>
  <body>
    <a class="skip-link" href="#main">{ct("Skip to content")}</a>
    <Header locale={locale} currentPath={currentPath} variant={headerVariant} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} />
  <script>
      // A courtesy deterrent for photographs; text, links and forms remain usable.
      for (const name of ['contextmenu', 'dragstart']) {
        document.addEventListener(name, event => {
          if (event.target instanceof HTMLImageElement && event.target.closest('main')) event.preventDefault();
        });
      }
    </script>
  </body>
</html>
