---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ResponsivePhoto from '../../components/ResponsivePhoto.astro';
import { getTranslations } from '../../i18n/translations';
import { locales, type Locale } from '../../i18n/utils';
import processLayout from '../../data/process-layout.json';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const t = getTranslations(locale);
const searchReflection: Record<Locale, string> = {
  "en": "The question. In the case of FLOW it was, can I capture the universe performing its cosmic dance? The distortion of light and the perception of time when sea and land meet. It takes me a while to work out the visual language of the series and requires several hundred images to find the right balance. After months of shooting and curation the series starts to take shape and finishes with the series you see here.",
  "fr": "La question. Pour FLOW, c’était : puis-je saisir l’univers dans sa danse cosmique ? La distorsion de la lumière et de la perception du temps lorsque la mer et la terre se rencontrent. Il me faut du temps pour trouver le langage visuel de la série, et plusieurs centaines d’images sont nécessaires pour trouver le juste équilibre. Après des mois de prises de vue et de sélection, la série commence à prendre forme et aboutit à celle que vous voyez ici.",
  "es": "La pregunta. En el caso de FLOW fue: ¿puedo capturar el universo interpretando su danza cósmica? La distorsión de la luz y de la percepción del tiempo cuando el mar y la tierra se encuentran. Me lleva tiempo encontrar el lenguaje visual de la serie y requiere varios cientos de imágenes para encontrar el equilibrio adecuado. Tras meses de fotografías y selección, la serie empieza a tomar forma y culmina en la que ven aquí.",
  "it": "La domanda. Nel caso di FLOW era: posso catturare l’universo mentre esegue la sua danza cosmica? La distorsione della luce e della percezione del tempo quando mare e terra si incontrano. Mi occorre tempo per trovare il linguaggio visivo della serie, e servono diverse centinaia di immagini per trovare il giusto equilibrio. Dopo mesi di scatti e selezione, la serie comincia a prendere forma e si conclude con quella che vedete qui.",
  "de": "Die Frage. Bei FLOW lautete sie: Kann ich das Universum bei seinem kosmischen Tanz festhalten? Die Verzerrung des Lichts und die Wahrnehmung der Zeit, wenn Meer und Land aufeinandertreffen. Ich brauche eine Weile, um die Bildsprache der Serie zu finden, und es braucht mehrere Hundert Bilder, um die richtige Balance zu finden. Nach Monaten des Fotografierens und Auswählens nimmt die Serie allmählich Gestalt an und wird schließlich zu der Serie, die Sie hier sehen.",
  "ja": "問い。FLOWの場合は、「宇宙がその壮大なダンスを踊る姿を捉えられるだろうか」という問いでした。海と陸が出会うときの光の歪みと、時間の知覚。シリーズの視覚言語を見つけるには時間がかかり、適切なバランスを見つけるために数百枚の写真を撮る必要があります。何か月もの撮影と選定を経て、シリーズは少しずつ形を成し、やがてここでご覧いただく作品群に辿り着きます。",
  "zh": "问题。对于FLOW，这个问题是：我能否捕捉宇宙跳起它的宇宙之舞的那一刻？海陆相遇时光线的扭曲与时间的感知。我需要一段时间才能找到这一系列的视觉语言，需要拍摄数百张照片才能找到恰当的平衡。经过数月的拍摄与筛选，系列开始逐渐成形，最终成为您在这里看到的作品。"
};
const processAssets = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/**/*.{jpg,jpeg,png,webp,JPG,JPEG,PNG,WEBP}', { eager: true }
);
function resolvePhoto(path: string) {
  const photo = processAssets['/' + path]?.default;
  if (!photo) throw new Error('Missing PROCESS image: ' + path);
  return photo;
}
const searchPhotos = processLayout.squares;
const processImages = processLayout.gallery;
function galleryCaption(item: (typeof processImages)[number]) {
  return item.captionKey ? t.studio[item.captionKey as keyof typeof t.studio] as string : '';
}

---

<BaseLayout locale={locale} title={t.studio.title} description={t.studio.intro}>
  <header class="page-header container">
    <h1>{t.studio.title}</h1>
    <div class="page-header__body">
      {t.studio.processIntro.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </header>

  <div class="search-sequence container">
    {searchPhotos.map((item) => (
      <figure class="search-sequence__item">
        <Image src={resolvePhoto(item.path)} alt={item.captions[locale]} class="search-sequence__image"
          widths={[320, 640, 960]} sizes="(max-width: 599px) 45vw, (max-width: 1199px) 30vw, 16vw"
          format="webp" loading="lazy" />
        <figcaption>{item.captions[locale]}</figcaption>
      </figure>
    ))}
  </div>

  <div class="search-reflection container">
    <p>{searchReflection[locale]}</p>
  </div>

  {processImages.length > 0 && (
    <div class="process-gallery">
      <div class="process-gallery__row">
        {processImages.slice(0, 2).map((item) => (
          <figure class:list={["process-image-item", { "process-image-item--scale": item.captionKey === "scaleCaption" }]}>
            <ResponsivePhoto
              src={resolvePhoto(item.path)}
              assetPath={item.path.replace('src/assets/', '')}
              alt={t.studio.title}
              class="process-gallery__image"
              sizes="(max-width: 760px) 100vw, 50vw"
              loading="lazy"
            />
            {galleryCaption(item) && (
              <figcaption class="process-caption">{galleryCaption(item)}</figcaption>
            )}
          </figure>
        ))}
      </div>
      <p class="process-note">
        {t.studio.archivalNote}
      </p>
      <div class="process-gallery__row">
        {processImages.slice(2).map((item) => (
          <Fragment>
            <figure class:list={["process-image-item", { "process-image-item--scale": item.captionKey === "scaleCaption" }]}>
              <ResponsivePhoto
                src={resolvePhoto(item.path)}
                assetPath={item.path.replace('src/assets/', '')}
                alt={t.studio.title}
                class="process-gallery__image"
                sizes="(max-width: 760px) 100vw, 50vw"
                loading="lazy"
              />
              {galleryCaption(item) && (
                <figcaption class="process-caption">{galleryCaption(item)}</figcaption>
              )}
              {item.captionKey === "scaleCaption" && (
                <Image
                  src={resolvePhoto('src/assets/about/Scale-interior.webp')}
                  alt={t.studio.scaleCaption}
                  class="scale-companion"
                  widths={[320, 640, 1000]}
                  sizes="(min-width: 760px) 15.625vw, 31.25vw"
                  format="webp"
                  loading="lazy"
                />
              )}
            </figure>
          </Fragment>
        ))}
      </div>
    </div>
  )}
</BaseLayout>

<style>
  .search-reflection {
    max-width: 900px;
    margin-block: 0 64px;
    color: var(--color-ink-soft);
    font-family: var(--font-display);
    font-size: 1.235rem;
    line-height: 1.6;
  }

  .search-sequence {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 32px 20px;
    margin-block: 48px 64px;
  }
  .search-sequence__item { margin: 0; min-width: 0; }
  .search-sequence :global(.search-sequence__image) {
    display: block; width: 100%; height: auto; aspect-ratio: 1; object-fit: cover;
  }
  .search-sequence figcaption {
    margin-top: 14px; text-align: center;
    font-family: var(--font-display); color: var(--color-ink-soft);
    font-size: 1.1rem; line-height: 1.4;
  }
  @media (min-width: 600px) {
    .search-sequence { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 36px 24px; }
  }
  @media (min-width: 1200px) {
    .search-sequence { grid-template-columns: repeat(6, minmax(0, 1fr)); }
  }

  .page-header {
    padding-block: clamp(56px, 10vw, 96px) 0;
    max-width: 680px;
  }

  .page-header h1 {
    font-size: clamp(2.4rem, 5vw, 3.6rem);
    margin-top: 12px;
  }

  .page-header__body {
    margin-top: 16px;
    color: var(--color-ink-soft);
    font-family: var(--font-display);
    max-width: 60ch;
  }

  .page-header__body p + p {
    margin-top: 16px;
  }

  .process-gallery {
    margin-top: 32px;
  }

  .process-gallery__row {
    display: grid;
    grid-template-columns: 1fr;
    align-items: start;
    gap: 4px;
  }

  :global(.process-gallery__image) {
    display: block;
    width: 100%;
    height: auto;
    object-fit: contain;
  }

  .process-image-item {
    margin: 0;
  }

  .process-image-item--scale :global(.process-gallery__image) {
    width: 62.5%;
    margin-inline: auto;
  }

  .scale-companion {
    display: block;
    width: 31.25%;
    height: auto;
    margin: 24px auto;
  }

  .process-caption {
    margin-top: 4px;
    text-align: center;
    white-space: nowrap;
    color: var(--color-ink-soft);
    font-family: var(--font-display);
    font-size: 1.1rem;
    line-height: 1.4;
  }

  .process-image-item--scale .process-caption {
    white-space: normal;
  }

  .process-note {
    max-width: 900px;
    margin: 0 auto;
    padding: 50px clamp(20px, 5vw, 64px);
    color: var(--color-ink-soft);
    font-family: var(--font-display);
    font-size: 1.235rem;
    line-height: 1.26;
  }

  @media (min-width: 760px) {
    .process-gallery__row {
      grid-template-columns: 1fr 1fr;
    }

    .process-image-item--scale {
      grid-column: 1 / -1;
      position: relative;
      display: grid;
      grid-template-columns: 9.375% 31.25% minmax(0, 1fr);
      align-items: center;
    }

    .process-image-item--scale :global(.process-gallery__image) {
      grid-column: 2;
      width: 100%;
      margin: 0;
    }

    .process-image-item--scale .scale-companion {
      position: absolute;
      width: 15.625%;
      right: 9.375%;
      top: 50%;
      transform: translateY(-50%);
      margin: 0;
    }

    .process-image-item--scale .process-caption {
      grid-column: 3;
      margin: 0;
      padding: 0 24px;
      text-align: left;
    }
  }
</style>
