---
import { Image } from 'astro:assets';
import searchPhoto0 from '../../assets/process-search/Dog.jpg';
import searchPhoto1 from '../../assets/process-search/Space.jpg';
import searchPhoto2 from '../../assets/process-search/Camera.jpg';
import searchPhoto3 from '../../assets/process-search/Location.jpg';
import searchPhoto4 from '../../assets/process-search/Surf 2.jpg';
import searchPhoto5 from '../../assets/process-search/Surf 1.jpg';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ResponsivePhoto from '../../components/ResponsivePhoto.astro';
import { getTranslations } from '../../i18n/translations';
import { locales, type Locale } from '../../i18n/utils';
import { getAboutImages } from '../../lib/seriesImages';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const t = getTranslations(locale);
const searchReflection: Record<Locale, string> = {
  "en": "I tend to start with a question. In the case of FLOW it was, can I capture the universe performing its cosmic dance. It's about the distortion of light and the perception of time when sea and land meet. It takes me a while to work out the visual language of the series and requires hundreds of images that don't answer the question. After months of shooting and curation the series starts to take shape and finishes with the series you see here.",
  "fr": "J’ai tendance à commencer par une question. Pour FLOW, c’était : puis-je saisir l’univers dans sa danse cosmique ? Il s’agit de la distorsion de la lumière et de la perception du temps lorsque la mer et la terre se rencontrent. Il me faut du temps pour trouver le langage visuel de la série, et des centaines d’images qui ne répondent pas à la question. Après des mois de prises de vue et de sélection, la série commence à prendre forme et aboutit à celle que vous voyez ici.",
  "es": "Suelo empezar con una pregunta. En el caso de FLOW fue: ¿puedo capturar el universo interpretando su danza cósmica? Se trata de la distorsión de la luz y de la percepción del tiempo cuando el mar y la tierra se encuentran. Me lleva tiempo encontrar el lenguaje visual de la serie y requiere cientos de imágenes que no responden a la pregunta. Tras meses de fotografías y selección, la serie empieza a tomar forma y culmina en la que ven aquí.",
  "it": "Tendo a partire da una domanda. Nel caso di FLOW era: posso catturare l’universo mentre esegue la sua danza cosmica? Si tratta della distorsione della luce e della percezione del tempo quando mare e terra si incontrano. Mi occorre tempo per trovare il linguaggio visivo della serie, e servono centinaia di immagini che non rispondono alla domanda. Dopo mesi di scatti e selezione, la serie comincia a prendere forma e si conclude con quella che vedete qui.",
  "de": "Ich beginne meist mit einer Frage. Bei FLOW lautete sie: Kann ich das Universum bei seinem kosmischen Tanz festhalten? Es geht um die Verzerrung des Lichts und die Wahrnehmung der Zeit, wenn Meer und Land aufeinandertreffen. Ich brauche eine Weile, um die Bildsprache der Serie zu finden, und dafür entstehen Hunderte von Bildern, die die Frage nicht beantworten. Nach Monaten des Fotografierens und Auswählens nimmt die Serie allmählich Gestalt an und wird schließlich zu der Serie, die Sie hier sehen.",
  "ja": "私はたいてい、一つの問いから始めます。FLOWの場合は、「宇宙がその壮大なダンスを踊る姿を捉えられるだろうか」という問いでした。海と陸が出会うときの光の歪みと、時間の知覚をめぐるものです。シリーズの視覚言語を見つけるには時間がかかり、その問いに答えられない写真を何百枚も撮る必要があります。何か月もの撮影と選定を経て、シリーズは少しずつ形を成し、やがてここでご覧いただく作品群に辿り着きます。",
  "zh": "我往往从一个问题开始。对于FLOW，这个问题是：我能否捕捉宇宙跳起它的宇宙之舞的那一刻？它关乎海陆相遇时光线的扭曲与时间的感知。我需要一段时间才能找到这一系列的视觉语言，为此要拍摄数百张无法回答那个问题的照片。经过数月的拍摄与筛选，系列开始逐渐成形，最终成为您在这里看到的作品。"
};
const searchCaptions: Record<Locale, string[]> = {
  "en": [
    "Consult with one of these",
    "Consider our place",
    "Get one of these",
    "Look for the elements",
    "Experiment",
    "Keep looking"
  ],
  "fr": [
    "Consultez l’un d’eux",
    "Réfléchissez à notre place",
    "Procurez-vous un de ces appareils",
    "Cherchez les éléments",
    "Expérimentez",
    "Continuez à regarder"
  ],
  "es": [
    "Consulta con uno de estos",
    "Reflexiona sobre nuestro lugar",
    "Consigue uno de estos",
    "Busca los elementos",
    "Experimenta",
    "Sigue mirando"
  ],
  "it": [
    "Consulta uno di loro",
    "Considera il nostro posto",
    "Procurati uno di questi",
    "Cerca gli elementi",
    "Sperimenta",
    "Continua a guardare"
  ],
  "de": [
    "Frag einen von ihnen",
    "Denk über unseren Platz nach",
    "Besorg dir so eine",
    "Such nach den Elementen",
    "Experimentiere",
    "Schau weiter"
  ],
  "ja": [
    "こんな相棒に相談する",
    "私たちの居場所を考える",
    "こんな一台を手に入れる",
    "自然の要素を探す",
    "実験する",
    "見つめ続ける"
  ],
  "zh": [
    "向这样的伙伴请教",
    "思考我们的位置",
    "准备一台这样的相机",
    "寻找自然元素",
    "尝试",
    "继续观察"
  ]
};
const searchPhotos = [searchPhoto0, searchPhoto1, searchPhoto2, searchPhoto3, searchPhoto4, searchPhoto5];
const aboutImages = getAboutImages();
const processEight = aboutImages.find(({ filename }) => filename === 'Process-8.jpg');
const processImages = aboutImages
  .filter(({ filename }) => filename.startsWith('Process-') && filename !== 'Process-8.jpg')
  .map((loadedImage) =>
    loadedImage.filename === 'Process-7.jpg' && processEight
      ? { ...loadedImage, image: processEight.image, assetPath: processEight.assetPath }
      : loadedImage
  );
---

<BaseLayout locale={locale} title={t.studio.title} description={t.studio.intro}>
  <header class="page-header container">
    <h1>{t.studio.title}</h1>
    <p class="page-header__lede">{t.studio.intro}</p>
    <div class="page-header__body">
      {t.studio.processIntro.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </header>

  <div class="search-sequence container">
    {searchPhotos.map((photo, index) => (
      <figure class="search-sequence__item">
        <Image src={photo} alt={searchCaptions[locale][index]} class="search-sequence__image"
          widths={[320, 640, 960]} sizes="(max-width: 599px) 45vw, (max-width: 1199px) 30vw, 16vw"
          format="webp" loading="lazy" />
        <figcaption>{searchCaptions[locale][index]}</figcaption>
      </figure>
    ))}
  </div>

  <div class="search-reflection container">
    <p>{searchReflection[locale]}</p>
  </div>

  {processImages.length > 0 && (
    <div class="process-gallery">
      <div class="process-gallery__row">
        {processImages.slice(0, 2).map(({ image, filename, assetPath }) => (
          <figure class="process-image-item">
            <ResponsivePhoto
              src={image}
              assetPath={assetPath}
              alt={t.studio.title}
              class="process-gallery__image"
              sizes="(max-width: 760px) 100vw, 50vw"
              loading="lazy"
            />
            {filename === 'Process-2.jpg' && (
              <figcaption class="process-caption">{t.studio.tonalCaption}</figcaption>
            )}
          </figure>
        ))}
      </div>
      <p class="process-note">
        {t.studio.archivalNote}
      </p>
      <div class="process-gallery__row">
        {processImages.slice(2).map(({ image, filename, assetPath }) => (
          <Fragment>
            <figure class="process-image-item">
              <ResponsivePhoto
                src={image}
                assetPath={assetPath}
                alt={t.studio.title}
                class="process-gallery__image"
                sizes="(max-width: 760px) 100vw, 50vw"
                loading="lazy"
              />
              {filename === 'Process-5.jpg' && (
                <figcaption class="process-caption">{t.studio.mattingCaption}</figcaption>
              )}
              {filename === 'Process-6.jpeg' && (
                <figcaption class="process-caption">{t.studio.veniceCaption}</figcaption>
              )}
            </figure>
            {filename === 'Process-7.jpg' && (
              <p class="process-caption process-side-caption">{t.studio.scaleCaption}</p>
            )}
          </Fragment>
        ))}
      </div>
    </div>
  )}
</BaseLayout>

<style>
  .search-reflection {
    max-width: 900px;
    margin-block: 0 64px;
    color: var(--color-ink-soft);
    font-family: var(--font-display);
    font-size: 1.235rem;
    line-height: 1.6;
  }

  .search-sequence {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 32px 20px;
    margin-block: 48px 64px;
  }
  .search-sequence__item { margin: 0; min-width: 0; }
  .search-sequence :global(.search-sequence__image) {
    display: block; width: 100%; height: auto; aspect-ratio: 1; object-fit: cover;
  }
  .search-sequence figcaption {
    margin-top: 14px; text-align: center;
    font-family: var(--font-display); color: var(--color-ink-soft);
    font-size: 1.1rem; line-height: 1.4;
  }
  @media (min-width: 600px) {
    .search-sequence { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 36px 24px; }
  }
  @media (min-width: 1200px) {
    .search-sequence { grid-template-columns: repeat(6, minmax(0, 1fr)); }
  }

  .page-header {
    padding-block: clamp(56px, 10vw, 96px) 0;
    max-width: 680px;
  }

  .page-header h1 {
    font-size: clamp(2.4rem, 5vw, 3.6rem);
    margin-top: 12px;
  }

  .page-header__lede {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.1rem;
    margin-top: 20px;
  }

  .page-header__body {
    margin-top: 16px;
    color: var(--color-ink-soft);
    font-family: var(--font-display);
    max-width: 60ch;
  }

  .page-header__body p + p {
    margin-top: 16px;
  }

  .process-gallery {
    margin-top: 32px;
  }

  .process-gallery__row {
    display: grid;
    grid-template-columns: 1fr;
    align-items: start;
    gap: 4px;
  }

  :global(.process-gallery__image) {
    display: block;
    width: 100%;
    height: auto;
    object-fit: contain;
  }

  .process-image-item {
    margin: 0;
  }

  .process-caption {
    margin-top: 4px;
    text-align: center;
    white-space: nowrap;
    color: var(--color-ink-soft);
    font-family: var(--font-display);
    font-size: 1.62rem;
  }

  .process-side-caption {
    align-self: center;
    justify-self: start;
    margin: 0 0 0 10%;
  }

  .process-note {
    max-width: 900px;
    margin: 0 auto;
    padding: 100px clamp(20px, 5vw, 64px);
    color: var(--color-ink-soft);
    font-family: var(--font-display);
    font-size: 1.53rem;
    line-height: 1.26;
  }

  @media (min-width: 760px) {
    .process-gallery__row {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
