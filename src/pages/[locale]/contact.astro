---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getTranslations } from '../../i18n/translations';
import { locales, type Locale } from '../../i18n/utils';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const t = getTranslations(locale);

const contactEndpoint = 'https://formspree.io/f/mdekzkeb';
---

<BaseLayout locale={locale} title={t.contact.title} description={t.contact.intro}>
  <div class="contact container">
    <header class="contact__header">
      <h1>{t.contact.title}</h1>
      <p>{t.contact.intro}</p>
    </header>

    <form
      class="contact-form"
      action={contactEndpoint}
      method="POST"
      data-locale={locale}
      data-sending={t.contact.sending}
      data-success={t.contact.success}
      data-error={t.contact.error}
    >
      <label>
        {t.contact.nameLabel}
        <input type="text" name="name" required />
      </label>
      <label>
        {t.contact.emailLabel}
        <input type="email" name="email" required />
      </label>
      <label>
        {t.contact.messageLabel}
        <textarea name="message" rows="6" required></textarea>
      </label>
      <div class="contact-form__trap" aria-hidden="true">
        <label>
          Company
          <input type="text" name="company" tabindex="-1" autocomplete="off" />
        </label>
      </div>
      <button class="btn" type="submit">{t.contact.submit}</button>
      <p class="form-status" role="status" aria-live="polite" hidden></p>
      <p class="contact-note">{t.contact.note}</p>
    </form>
  </div>
</BaseLayout>

<script>
  const contactForm = document.querySelector<HTMLFormElement>('.contact-form');
  const submitButton = contactForm?.querySelector<HTMLButtonElement>('button[type="submit"]');
  const formStatus = contactForm?.querySelector<HTMLElement>('.form-status');

  if (contactForm) {
    contactForm.addEventListener('submit', async (event) => {
      event.preventDefault();

      if (!submitButton || !formStatus) return;

      const originalLabel = submitButton.textContent ?? '';
      submitButton.disabled = true;
      submitButton.textContent = contactForm.dataset.sending ?? originalLabel;
      formStatus.hidden = true;
      formStatus.classList.remove('form-status--success', 'form-status--error');

      try {
        const formData = new FormData(contactForm);
        formData.append('locale', contactForm.dataset.locale ?? 'en');
        const response = await fetch(contactForm.action, {
          method: 'POST',
          headers: { 'Accept': 'application/json' },
          body: formData,
        });

        if (!response.ok) throw new Error('Form submission failed');

        contactForm.reset();
        formStatus.textContent = contactForm.dataset.success ?? 'Thank you.';
        formStatus.classList.add('form-status--success');
      } catch {
        formStatus.textContent = contactForm.dataset.error ?? 'Please try again.';
        formStatus.classList.add('form-status--error');
      } finally {
        formStatus.hidden = false;
        submitButton.disabled = false;
        submitButton.textContent = originalLabel;
      }
    });
  }
</script>

<style>
  :global(body) {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  :global(main) {
    flex: 1;
  }

  .contact {
    padding-block: clamp(56px, 10vw, 96px) 0;
    display: grid;
    gap: 40px;
    max-width: 620px;
  }

  .contact__header h1 {
    font-size: clamp(2.4rem, 5vw, 3.6rem);
    margin-top: 12px;
  }

  .contact__header p {
    margin-top: 16px;
    color: var(--color-ink-soft);
    font-family: var(--font-display);
    font-size: 1.62rem;
  }

  .contact-form {
    display: grid;
    gap: 20px;
  }

  .contact-form label {
    display: grid;
    gap: 8px;
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink-soft);
  }

  .contact-form input,
  .contact-form textarea {
    font-family: var(--font-ui);
    font-size: 1rem;
    color: var(--color-ink);
    background: transparent;
    border: 1px solid var(--color-line);
    padding: 12px 14px;
    resize: vertical;
  }

  .contact-form input:focus,
  .contact-form textarea:focus {
    outline: 1px solid var(--color-ink);
  }

  .contact-form .btn {
    justify-self: start;
    background: transparent;
    cursor: pointer;
  }

  .contact-form .btn:disabled {
    cursor: wait;
    opacity: 0.55;
  }

  .contact-form__trap {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .form-status {
    margin: 0;
    font-size: 0.9rem;
  }

  .form-status--success {
    color: var(--color-ink);
  }

  .form-status--error {
    color: #8b2f2f;
  }

  .contact-note {
    font-size: 0.82rem;
    color: var(--color-ink-soft);
  }

  .contact-note code {
    background: var(--color-line);
    padding: 0.1em 0.4em;
  }
</style>
