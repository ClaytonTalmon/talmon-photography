---
import { collectorText } from '../../i18n/collector.mjs';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { locales, type Locale } from '../../i18n/utils';
import '../../styles/editions.css';
export function getStaticPaths() { return locales.map(locale=>({params:{locale}})); }
const {locale}=Astro.params as {locale:Locale};
const ct = (text: string) => collectorText(locale, text);
---
<BaseLayout locale={locale} title={ct("Mailing List")} description={ct("New work, upcoming exhibitions and occasional notes from the studio. Sign up below to stay in touch.")}>
<section class="editions signup-page">
 <span class="eyebrow">{ct("Notes from the studio")}</span>
 <h1>{ct("Mailing List")}</h1>
 <p class="intro">{ct("New work, upcoming exhibitions and occasional notes from the studio. Sign up below to stay in touch.")}</p>
 <section id="subscription-confirmation" hidden>
  <p id="confirmation-description">{ct("Confirm that you would like occasional news of new work and exhibitions.")}</p>
  <button id="subscription-confirm" class="primary">{ct("Confirm my subscription")}</button>
 </section>
 <form id="mailing-signup">
  <label>{ct("Email address")}<input name="email" type="email" autocomplete="email" required maxlength="254" /></label>
  <label class="honey" aria-hidden="true">Company<input name="company" tabindex="-1" autocomplete="off" /></label>
  <label class="check"><input name="consent" type="checkbox" required /><span>{ct("I would like to receive studio updates.")}</span></label>
  <button class="primary">{ct("Join the mailing list")}</button>
  <p class="small">{ct("Your email is used for studio updates. Subscription requires email confirmation; you can unsubscribe at any time.")}</p>
  <p class="small">{ct("To unsubscribe from the list, email")} <a href="mailto:studio@talmonphoto.com?subject=Unsubscribe">{ct(" the studio").trim()}</a>.</p>
 </form>
 <details id="unsubscribe-details"><summary class="small">{ct("Unsubscribe")}</summary>
  <form id="unsubscribe-form"><label>{ct("Email address")}<input type="email" name="email" autocomplete="email" required maxlength="254" /></label><label class="honey" aria-hidden="true">Company<input name="company" tabindex="-1" autocomplete="off" /></label><button>{ct("Send an unsubscribe link")}</button></form>
 </details>
 <p id="signup-status" class="notice" role="status" aria-live="polite"></p>
</section>
</BaseLayout>
<style>
 .signup-page { max-width:760px; padding-bottom:40px; }
 #signup-status:empty { display:none; }
 #mailing-signup, #unsubscribe-details { margin-top:28px; }
 #unsubscribe-form { display:grid; gap:16px; margin-top:16px; }
 #unsubscribe-form button { justify-self:start; }
</style>
<script>import '../../scripts/mailing-list.js';</script>
