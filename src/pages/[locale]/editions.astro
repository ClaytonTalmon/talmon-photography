---
import { collectorText } from '../../i18n/collector.mjs';
import CollectorExperience from '../../components/CollectorExperience.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { locales, type Locale } from '../../i18n/utils';
import '../../styles/editions.css';
import catalog from '../../data/edition-catalog.mjs';
export function getStaticPaths() {
 return locales.map(locale=>({params:{locale}}));
}

const {locale}=Astro.params as {locale:Locale};
const ct = (text: string) => collectorText(locale, text);
---
<BaseLayout locale={locale} title={ct("Editions & Acquisitions")} description={ct("A closer look at each work: its scale, edition and availability. Request private access to explore current acquisition prices.")}>
<CollectorExperience locale={locale} />
</BaseLayout>
