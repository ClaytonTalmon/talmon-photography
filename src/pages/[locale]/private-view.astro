---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getTranslations } from '../../i18n/translations';
import { locales, type Locale } from '../../i18n/utils';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
const t = getTranslations(locale);
const timeOptions = Array.from({ length: 96 }, (_, index) => {
  const hours = String(Math.floor(index / 4)).padStart(2, '0');
  const minutes = String((index % 4) * 15).padStart(2, '0');
  return `${hours}:${minutes}`;
});
const formspreeId = import.meta.env.PUBLIC_FORMSPREE_ID;
const formAction = formspreeId ? `https://formspree.io/f/${formspreeId}` : 'https://formspree.io/f/mdekzkeb';

---

<BaseLayout locale={locale} title={t.privateView.title} description={t.privateView.intro}>
  <div class="private-view container">
    <header class="private-view__header">
      <h1>{t.privateView.title}</h1>
      <p>{t.privateView.intro}</p>
    </header>

    <form
      id="pv-request-form"
      class="pv-request-form"
      action={formAction}
      method="POST"
      data-sending={t.contact.sending}
      data-success={t.contact.success}
      data-error={t.contact.error}
    >
      <label>
        {t.privateView.requestNameLabel}
        <input type="text" name="name" required />
      </label>
      <label>
        {t.privateView.requestEmailLabel}
        <input type="email" name="email" required />
      </label>
      <label>
        {t.privateView.collectionLabel}
        <select name="collection" required>
          <option value="" disabled selected>{t.privateView.collectionPlaceholder}</option>
          <option value="FORM">FORM</option>
          <option value="FLOW">FLOW</option>
          <option value="FLIGHT">FLIGHT</option>
          <option value="WORLD">WORLD</option>
        </select>
      </label>
      <div class="pv-request-form__row">
        <label>
          {t.privateView.requestDateLabel}
          <input type="date" name="date" required />
        </label>
        <label>
          {t.privateView.requestTimeLabel}
          <select name="time" required>
            <option value="" disabled selected>{t.privateView.requestTimeLabel}</option>
            {timeOptions.map((time) => <option value={time}>{time}</option>)}
          </select>
        </label>
      </div>
      <label>
        {t.privateView.requestMessageLabel}
        <textarea name="message" rows="5"></textarea>
      </label>
      <label>{({en:'Time zone',fr:'Fuseau horaire',ja:'タイムゾーン',es:'Zona horaria',it:'Fuso orario',zh:'时区',de:'Zeitzone'})[locale]}<input name="timezone" id="appointment-timezone" required maxlength="100" placeholder="Europe/Paris" /></label>
      <input type="hidden" name="locale" value={locale} />
      <input type="hidden" name="subject" value="Private viewing request" />
      <button class="btn" type="submit">{t.privateView.requestSubmit}</button>
      <p class="pv-status" role="status" aria-live="polite" hidden></p>
      <p class="pv-request-note">{t.privateView.requestNote}</p>
    </form>
  </div>
</BaseLayout>

<script>
  const requestForm = document.getElementById('pv-request-form') as HTMLFormElement | null;
  const submitButton = requestForm?.querySelector<HTMLButtonElement>('button[type="submit"]');
  const formStatus = requestForm?.querySelector<HTMLElement>('.pv-status');
  let sending = false;
  const timezone = document.querySelector<HTMLInputElement>('#appointment-timezone');
  if (timezone) timezone.defaultValue = Intl.DateTimeFormat().resolvedOptions().timeZone || 'UTC';
  const date = document.querySelector<HTMLInputElement>('[name="date"]');
  if (date) {
    const now = new Date();
    date.min = `${now.getFullYear()}-${String(now.getMonth()+1).padStart(2,'0')}-${String(now.getDate()).padStart(2,'0')}`;
  }

  if (requestForm && submitButton && formStatus) {
    requestForm.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (sending || !requestForm.reportValidity()) return;

      sending = true;
      const originalLabel = submitButton.textContent ?? '';
      submitButton.disabled = true;
      submitButton.textContent = requestForm.dataset.sending ?? originalLabel;
      requestForm.setAttribute('aria-busy', 'true');
      formStatus.hidden = true;
      formStatus.classList.remove('pv-status--error');

      try {
        const formData = new FormData(requestForm);
        const response = await fetch(requestForm.action, {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: formData,
        });
        if (!response.ok) throw new Error('Submission failed');

        requestForm.reset();
        formStatus.textContent = requestForm.dataset.success ?? 'Thank you. Your request has been sent.';
      } catch {
        formStatus.textContent = requestForm.dataset.error ?? 'Your request could not be sent. Please try again.';
        formStatus.classList.add('pv-status--error');
      } finally {
        formStatus.hidden = false;
        submitButton.disabled = false;
        submitButton.textContent = originalLabel;
        requestForm.removeAttribute('aria-busy');
        sending = false;
      }
    });
  }
</script>

<style>
  :global(body) {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  :global(main) {
    flex: 1;
  }

  .private-view {
    padding-block: clamp(56px, 10vw, 96px) clamp(96px, 14vw, 160px);
    max-width: 620px;
  }

  .private-view__header h1 {
    font-size: clamp(2.4rem, 5vw, 3.6rem);
    margin-top: 12px;
  }

  .private-view__header p {
    margin-top: 16px;
    color: var(--color-ink-soft);
    max-width: 52ch;
  }

  .pv-gate {
    margin-top: 40px;
    display: grid;
    gap: 20px;
    max-width: 360px;
  }

  .pv-gate label {
    display: grid;
    gap: 8px;
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink-soft);
  }

  .pv-gate input {
    font-family: var(--font-ui);
    font-size: 1rem;
    background: transparent;
    border: 1px solid var(--color-line);
    padding: 12px 14px;
  }

  .pv-gate input:focus {
    outline: 1px solid var(--color-ink);
  }

  .pv-gate .btn {
    justify-self: start;
    background: transparent;
    cursor: pointer;
  }

  .pv-error {
    color: #a4302a;
    font-size: 0.85rem;
  }

  .pv-content {
    margin-top: 48px;
    border-top: 1px solid var(--color-line);
    padding-top: 40px;
  }

  .pv-content h2 {
    font-size: 1.8rem;
  }

  .pv-content p {
    margin-top: 12px;
    color: var(--color-ink-soft);
  }

  .pv-request-form {
    margin-top: 32px;
    display: grid;
    gap: 20px;
  }

  .pv-request-form__row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: start;
    gap: 16px;
  }

  .pv-request-form label {
    display: grid;
    gap: 8px;
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-ink-soft);
  }

  .pv-request-form input,
  .pv-request-form textarea,
  .pv-request-form select {
    width: 100%;
    font-family: var(--font-ui);
    font-size: 1rem;
    color: var(--color-ink);
    background: transparent;
    border: 1px solid var(--color-line);
    padding: 12px 14px;
  }

  .pv-request-form textarea {
    resize: vertical;
  }

  .pv-request-form input,
  .pv-request-form select {
    min-height: 48px;
  }

  .pv-request-form input:focus,
  .pv-request-form textarea:focus,
  .pv-request-form select:focus {
    outline: 1px solid var(--color-ink);
  }

  .pv-request-form .btn {
    justify-self: start;
    background: transparent;
    cursor: pointer;
  }

  .pv-request-form .btn:disabled {
    cursor: wait;
    opacity: 0.55;
  }

  .pv-status {
    font-size: 0.9rem;
  }

  .pv-status--error {
    color: #8b2f2f;
  }

  .pv-request-note {
    font-size: 0.82rem;
  }

  .pv-note {
    margin-top: 32px;
    color: var(--color-ink-soft);
    font-size: 0.9rem;
  }

  .pv-note code {
    background: var(--color-line);
    padding: 0.1em 0.4em;
  }

  @media (max-width: 520px) {
    .pv-request-form__row {
      grid-template-columns: 1fr;
    }
  }
</style>
