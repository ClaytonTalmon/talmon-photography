---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import '../../../styles/editions.css';
---
<BaseLayout locale="en" title="Client experience preview">
<section class="editions preview">
 <span class="eyebrow">Studio preview</span><h1>The collector experience</h1>
 <p class="intro">Walk through the complete journey. These are sample details, prices and availability. Nothing is sent or saved, and no real password is issued.</p>
 <p class="small"><a href="/editions-editor/">Return to Studio Editor</a></p>
 <nav id="preview-steps" class="steps" aria-label="Client journey"></nav>
 <div class="toolbar"><h2 id="step-title"></h2><button id="preview-reset">Restart preview</button></div>
 <p id="step-description" class="small"></p>
 <p id="preview-status" role="status" class="small"></p>
 <iframe id="journey-frame" title="Client experience preview" sandbox="allow-scripts allow-same-origin allow-forms" referrerpolicy="no-referrer"></iframe>
 <div class="journey-controls"><button id="previous-step">Previous</button><button id="next-step" class="primary">Next</button></div>
</section>
</BaseLayout>
<script>import '../../../scripts/client-journey-preview.js';</script>
<style>
 .steps{display:flex;flex-wrap:wrap;gap:8px;margin:26px 0}
 .steps :global(button[aria-current="step"]){background:#24231f;color:#fff}
 #journey-frame{display:block;width:100%;height:1000px;border:1px solid #d8d4c9;background:#f2f0eb}
 .preview [hidden]{display:none!important}
 .journey-controls{display:flex;justify-content:space-between;gap:16px;margin-top:24px}
 .toolbar{justify-content:space-between}
 @media(max-width:760px){#journey-frame{height:850px}}
</style>
