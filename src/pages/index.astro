---
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const defaultPath = `${basePath}/en/`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="refresh" content={`0; url=${defaultPath}`} />
    <link rel="canonical" href={defaultPath} />
    <title>Talmon de l’Armée Photography</title>
  </head>
  <body>
    <p>Redirecting to <a href={defaultPath}>Talmon de l’Armée Photography</a>…</p>
  </body>
</html>
