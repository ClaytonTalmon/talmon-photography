---
import { collectorText } from '../i18n/collector.mjs';
import { getTranslations } from '../i18n/translations';
import { localizedPath, type Locale } from '../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const year = '2026';
const ct = (text: string) => collectorText(locale, text);
---

<footer class="site-footer">
  <div class="site-footer__inner container">
    <a class="wordmark" href={localizedPath(locale, '/')}>
      <span class="wordmark__name wordmark__lockup-line" aria-label="Talmon">
        <span aria-hidden="true">T</span><span aria-hidden="true">a</span><span aria-hidden="true">l</span><span aria-hidden="true">m</span><span aria-hidden="true">o</span><span aria-hidden="true">n</span>
      </span>
      <span class="wordmark__sub eyebrow eyebrow--light wordmark__lockup-line" aria-label="Limited Editions">
        <span aria-hidden="true">L</span><span aria-hidden="true">i</span><span aria-hidden="true">m</span><span aria-hidden="true">i</span><span aria-hidden="true">t</span><span aria-hidden="true">e</span><span aria-hidden="true">d</span><span aria-hidden="true">&nbsp;</span><span aria-hidden="true">E</span><span aria-hidden="true">d</span><span aria-hidden="true">i</span><span aria-hidden="true">t</span><span aria-hidden="true">i</span><span aria-hidden="true">o</span><span aria-hidden="true">n</span><span aria-hidden="true">s</span>
      </span>
    </a>

    <p class="tagline">{t.footer.tagline}</p>

    <nav class="footer-links" aria-label={locale === 'de' ? 'Fußzeile' : 'Footer'}>
      <a href={localizedPath(locale, '/contact')}>{t.nav.contact}</a>
      <a href={localizedPath(locale, '/private-view')}>{t.footer.privateView}</a>
      <a href={localizedPath(locale, '/mailing-list/')}>{ct("Mailing List")}</a>
      <a href="https://www.instagram.com/talmonphoto/" target="_blank" rel="noopener noreferrer">{t.footer.instagram}</a>
    </nav>
  </div>
  <div class="site-footer__bottom container">
    <span>© {year} {t.footer.rights}</span>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-dark-bg);
    color: var(--color-dark-ink);
    padding-top: 56px;
  }

  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 32px;
    padding-bottom: 40px;
  }

  .wordmark {
    text-decoration: none;
    color: inherit;
    width: 6.875rem;
    line-height: 1.2;
  }

  .wordmark__name {
    display: block;
    font-family: var(--font-display);
    font-size: 1.265rem;
  }

  .wordmark__sub {
    display: block;
    width: 90%;
    margin: 2px auto 0 0;
    font-size: 0.792rem;
  }

  .wordmark__lockup-line {
    display: flex;
    justify-content: space-between;
  }

  .tagline {
    max-width: 320px;
    font-size: 0.85rem;
    color: var(--color-dark-ink-soft);
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    font-size: 0.76rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .footer-links a {
    text-decoration: none;
  }

  .footer-links a:hover {
    opacity: 0.7;
  }

  .site-footer__bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    padding-block: 20px;
    font-size: 0.72rem;
    color: var(--color-dark-ink-soft);
  }
</style>
