---
import { getTranslations } from '../i18n/translations';
import { localizedPath, type Locale } from '../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale);
const year = '2026';
---

<footer class="site-footer">
  <div class="site-footer__inner container">
    <a class="wordmark" href={localizedPath(locale, '/')}>
      <span class="wordmark__name">Talmon de l’Armée</span>
      <span class="wordmark__sub eyebrow eyebrow--light">{locale === 'de' ? 'Fotografie' : 'Photography'}</span>
    </a>

    <p class="tagline">{t.footer.tagline}</p>

    <nav class="footer-links" aria-label={locale === 'de' ? 'Fußzeile' : 'Footer'}>
      <a href={localizedPath(locale, '/contact')}>{t.nav.contact}</a>
      <a href={localizedPath(locale, '/private-view')}>{t.footer.privateView}</a>
      <a href="https://instagram.com" target="_blank" rel="noopener noreferrer">{t.footer.instagram}</a>
    </nav>
  </div>
  <div class="site-footer__bottom container">
    <span>© {year} {t.footer.rights}</span>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-dark-bg);
    color: var(--color-dark-ink);
    padding-top: 56px;
  }

  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 32px;
    padding-bottom: 40px;
  }

  .wordmark {
    text-decoration: none;
    color: inherit;
  }

  .wordmark__name {
    display: block;
    font-family: var(--font-display);
    font-size: 1.1rem;
  }

  .wordmark__sub {
    display: block;
    margin-top: 2px;
  }

  .tagline {
    max-width: 320px;
    font-size: 0.85rem;
    color: var(--color-dark-ink-soft);
  }

  .footer-links {
    display: flex;
    gap: 20px;
    font-size: 0.76rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .footer-links a {
    text-decoration: none;
  }

  .footer-links a:hover {
    opacity: 0.7;
  }

  .site-footer__bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    padding-block: 20px;
    font-size: 0.72rem;
    color: var(--color-dark-ink-soft);
  }
</style>
