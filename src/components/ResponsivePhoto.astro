---
interface Props {
  src: ImageMetadata;
  assetPath: string;
  alt: string;
  sizes: string;
  class?: string;
  loading?: 'eager' | 'lazy';
  fetchpriority?: 'high' | 'low' | 'auto';
}

const {
  src,
  assetPath,
  alt,
  sizes,
  class: className,
  loading = 'lazy',
  fetchpriority,
} = Astro.props;

const maxWidth = Math.min(src.width, Math.floor(2000 * src.width / Math.max(src.width, src.height)));
const displayWidths = [...new Set([640, 1200, 1800, 2000].map(width => Math.min(width, maxWidth)))].sort((a,b)=>a-b);
const encodedPath = assetPath.split('/').map(encodeURIComponent).join('/');
const displayUrl = (width: number) => `/_images/${encodedPath}-${width}.webp`;
const srcset = displayWidths.map(width => `${displayUrl(width)} ${width}w`).join(', ');
---

<img
  src={displayUrl(displayWidths[0])}
  draggable="false"
  srcset={srcset}
  alt={alt}
  class={className}
  width={src.width}
  height={src.height}
  sizes={sizes}
  loading={loading}
  decoding="async"
  fetchpriority={fetchpriority}
/>
